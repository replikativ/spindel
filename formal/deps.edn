{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.replikativ/ansatz {:mvn/version "0.2.634"}}
 :aliases
 {;; check against the local ansatz checkout instead of the release
  :ansatz-local {:override-deps {org.replikativ/ansatz {:local/root "../ansatz"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["-Xmx1g" "-Xss16m"]
         :main-opts ["-m" "cognitect.test-runner"]}
  :repl {:extra-paths ["test"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}
         :jvm-opts ["-Xss16m"]
         :main-opts ["-m" "nrepl.cmdline"]}}}
