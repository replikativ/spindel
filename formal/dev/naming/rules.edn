 ;; ---------------------------------------------------------------------------------------------
 ;; Stems: hyphen tokens of theorem (and derived definition) names that are not definitions.
 ;; :t the T-numbered theorems gain their verb (wf-<def>, <def>-refuse, <def>-l4).
 :stems
 {t2 t2-write, t3 t3-create, t3-top t3-create-top, t4 t4-spawn, t4-top t4-spawn-top, t5 t5-start,
  t6 t6-await, t7 t7-track, t9 t9-fire, t11 t11-dispatch, t12 t12-complete, t14 t14-cancel,
  t16 t16-close-scope, t17 t17-arm, t18 t18-resource-fire, t22 t22-host-await,
  t22-un t22-host-unawait, t1-top t1-create-nonstream-top, sched t-schedule
  ;; members campaigns (decision 15)
  hm3 current-members, h3r current-members-rest
  h9 current-members, h10 current-members, h11 current-members, h12 current-members, h13 current-members,
  h14 current-members, h15 current-members, h16 current-members, h17 current-members, h18 current-members
  ;; abbreviations spelled out
  casc cascade, src source, blk blocked}

 ;; prefixes a DEFINITION's name follows (besides the parts): the members campaigns
 :family-stems
 {h3 current-members
  h9 current-members, h10 current-members, h11 current-members, h12 current-members, h13 current-members,
  h14 current-members, h15 current-members, h16 current-members, h17 current-members, h18 current-members}
 ;; exact entries whose derived definitions follow them as a prefix (kw8-ss, rk10-up)
 :def-families #{kw kw8 kw10 rk10 ck10 tk10 bc}

 ;; a members-campaign lemma that would collide after the merge takes its namespace's topic word
 :stage-topic {h9 await-wire, h10 await-fill, h11 await-post, h12 await-guard, h13 track-take,
               h14 dispatch, h15 raw-lifts, h16 complete, h17 raw, h18 step}

 ;; ---------------------------------------------------------------------------------------------
 ;; step.clj legacy (decision 18): deleted if nothing outside the set references it. At the
 ;; substitution nothing was: test/spindel/v2/step_test.clj and rule_test.clj drove the compiled
 ;; `st/dispatch`, which called t1-create-source, t8-observe, t15-resource-ack and retire-check, and
 ;; step_test listed the lemmas. (Candidates were: dispatch run-items t1-create-source t8-observe
 ;; t15-resource-ack retire retire-check close-scope-shallow.)
 ;; Since then the two tests drive engine.clj's `transition` and the set is deleted by hand, after
 ;; the substitution: 27 constants, the :deleted list of notes/renames.edn. The roots stay empty
 ;; here because this file describes the substitution as it ran.
 :legacy-roots []

 ;; Clojure vars of the generators that carry an old name (not constants of the model)
 :clj-vars {raw0-branch-name transition-branch-name}

 ;; names the segmentation must leave alone (the token is not the renamed definition)
 :keep #{gk-all          ; members/cascade: the job list `gk` of a cascade, not the part gk
         kc-r kc-c       ; inv/i10: "keeps current" row predicates, not the part kc
         rk-is           ; inv/i14: a rank test
         }

 ;; hyphen tokens that must not survive in a new name (lint)
 :stale-tokens #{raw0 raw0g gl ga gx g1 g5 g7 g8 g9 g10 g10r gr0 grx gso gw gy gd gc gk gst gos gox gnf gcy
                 mdb mdk esb aha svb ekb hmk hkw hsw kdb edb awo krb neb nzb vq vr v14 p3b p3c p3d p3e
                 p3f p3g p3h p3i p3j p3k p3l p3la p3m hm3 h3 rr casc glx l10k sample
                 kw kw8 kw10 ri sok bc bn qinv ar ch na ka kc kx mb fb nq gr h9 h10 h11 h12 h13 h14 h15 h16 h17 h18
                 norm blk src}}
