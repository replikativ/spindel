  CK7 I7IdleCompKey, ck7 i7-idle-comp-key
  RK7 I7IdleRunKey, rk7 i7-idle-run-key
  g7k i7-idle-keys-ok
  RK3 CurrentMembersRunKey, rk3 current-members-run-key
  RK10 I10CurrentRunKey, rk10 i10-current-run-key, rk10-id i10-current-run-key-id, rk10s i10-current-run-keys
  CK10 I10CurrentCompKey, ck10 i10-current-comp-key, ck10-id i10-current-comp-key-id, ck10s i10-current-comp-keys
  TK10 I10CurrentTaskKey, tk10 i10-current-task-key, tk10-id i10-current-task-key-id, tk10s i10-current-task-keys
  r10 i10-current-run-ok, c10 i10-current-comp-ok, t10 i10-current-task-ok
  g10k i10-current-exempt-keys-ok
