#!/usr/bin/env bash

set -o errexit
set -o pipefail

echo "Running ClojureScript tests (:ci build)"
rm out/ci-tests.js 2>/dev/null || true
npx shadow-cljs release ci
cljs_test_output=$(mktemp)
trap 'rm -f "$cljs_test_output"' EXIT
require_completed_suite() {
  if ! grep -Eq '^Ran [1-9][0-9]* tests containing [1-9][0-9]* assertions\.$' "$cljs_test_output"; then
    echo "ClojureScript tests exited without a completed test summary." >&2
    exit 1
  fi
}
node out/ci-tests.js | tee "$cljs_test_output"
require_completed_suite
# Exercise managed-cell heap probes separately from the legacy DOM GC profile.
node --expose-gc out/ci-tests.js --test=org.replikativ.spindel.engine.cell-handles-test,org.replikativ.spindel.engine.native-cells-test | tee "$cljs_test_output"
require_completed_suite
npx shadow-cljs release native-cell-gc
node --expose-gc out/native-cell-gc.js
